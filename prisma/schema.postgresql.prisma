  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// WebauthnChallenge: dÃ©fi Ã©phÃ©mÃ¨re d'une cÃ©rÃ©monie WebAuthn (login ou
// register), consommÃ© Ã  la vÃ©rification, expirÃ© aprÃ¨s 5 min â€” purge paresseuse
// par la route qui en crÃ©e un (mÃªme hygiÃ¨ne que OtpCode).
model WebauthnChallenge {
  id        String   @id @default(cuid())
