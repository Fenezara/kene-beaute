// ─────────────────────────── Idempotence Webhooks Fintech ───────────────────────────
// Enregistre les événements webhooks reçus de Wave, Orange Money, WiniPayer, etc.
// Garantit qu'un événement renvoyé (retry automatique) n'est JAMAIS exécuté deux fois
// (protection absolue contre les doubles débits, doubles ventes et sur-crédits).
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   // "wave" | "orange" | "winipayer" | "africastalking"
  eventId     String   // Identifiant de transaction ou signature unique externe
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventId])
}


