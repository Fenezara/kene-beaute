// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Console â€” passkeys & dÃ©fis WebAuthn (t. 130) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// PasskeyCredential: un appareil enregistrÃ© par la fondatrice pour ouvrir la
// Console KÃ¨nÃ¨. La clÃ© publique COSE est stockÃ©e en base64url; la partie
// privÃ©e ne quitte JAMAIS l'appareil (enclave sÃ©curisÃ©e / clÃ© USB).
// `credentialId` est l'identifiant WebAuthn (base64url), unique.
model PasskeyCredential {
