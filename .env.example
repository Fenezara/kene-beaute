# ==============================================================================
# KÈNÈ BEAUTÉ & BIEN-ÊTRE — FICHIER DE CONFIGURATION D'ENVIRONNEMENT (EXEMPLE)
# ==============================================================================
# Plateforme e-commerce, salon pro, diagnostic IA & paiement mobile (CI / SN)
# Copiez ce fichier vers .env et renseignez vos clés de production.

# ------------------------------------------------------------------------------
# 1. APPLICATION & BASE DE DONNÉES
# ------------------------------------------------------------------------------
# URL de connexion Prisma (SQLite en local / PostgreSQL en production)
DATABASE_URL="file:../db/custom.db"
# En production PostgreSQL :
# DATABASE_URL="postgresql://kene_user:StrongPassword@localhost:5432/kene_prod?schema=public"

# URL publique de l'application
APP_URL="https://kene.app"
NEXT_PUBLIC_APP_URL="https://kene.app"

# Secret de chiffrement pour les cookies et sessions Kènè (au moins 32 caractères)
KENE_SESSION_SECRET="change-this-to-a-very-long-and-secure-random-secret-key-32chars"
PUSH_SECRET="kene-push-secret-auth"

# Port d'écoute Next.js (défaut: 3000)
PORT=3000
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 2. SERVICE WEBSOCKET & NOTIFICATIONS TEMPS RÉEL (notify-service)
# ------------------------------------------------------------------------------
# URL du microservice Socket.IO pour les notifications instantanées
NOTIFY_SERVICE_URL="http://localhost:3004"
NOTIFY_PORT=3004

# ------------------------------------------------------------------------------
# 3. PASSERELLE FINTECH UNIFIÉE WINIPAYER (Wave, Orange Money, MTN MoMo, Moov)
# ------------------------------------------------------------------------------
# Clé API WiniPayer (wp_live_... ou wp_test_...)
WINIPAYER_API_KEY=""
WINIPAYER_SECRET_KEY=""
WINIPAYER_BASE_URL="https://api.winipayer.com"

# ------------------------------------------------------------------------------
# 4. PASSERELLE SMS TRANSACTIONNEL & OTP ZAVU (Côte d'Ivoire & Sénégal)
# ------------------------------------------------------------------------------
# Clé API Zavu (zv_live_... ou zv_test_...) — repli simulation automatique si vide
ZAVU_API_KEY=""

# ------------------------------------------------------------------------------
# 5. PASSERELLE DE PAIEMENT WAVE MOBILE MONEY (Directe, optionnelle)
# ------------------------------------------------------------------------------
# Clé API fournie par le portail marchand Wave (https://business.wave.com)
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""
WAVE_API_URL="https://api.wave.com/v1"

# ------------------------------------------------------------------------------
# 6. PASSERELLE DE PAIEMENT ORANGE MONEY WEB PAYMENT (OM OMWeb direct, optionnel)
# ------------------------------------------------------------------------------
# Identifiants développeur Orange Money (Orange Developer Portal)
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""
ORANGE_MONEY_AUTH_HEADER=""
ORANGE_MONEY_ENVIRONMENT="production"

# ------------------------------------------------------------------------------
# 7. PASSERELLE SMS PANAFRICAINE AFRICA'S TALKING (Africa API, Optionnelle)
# ------------------------------------------------------------------------------
# Inscription sur https://africastalking.com (Couverture Côte d'Ivoire, Sénégal, etc.)
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_SENDER_ID="Kene"

# ------------------------------------------------------------------------------
# 8. PASSERELLE SMS ALTERNATIVE TERMII (Optionnelle)
# ------------------------------------------------------------------------------
# Clé API Termii (https://termii.com)
TERMII_API_KEY=""

# Nom d'émetteur validé par les opérateurs ARTP / ARTCI (max 11 caractères)
TERMII_SENDER_ID="Kene"

# ------------------------------------------------------------------------------
# 6. PUSH NOTIFICATIONS WEB (VAPID / Service Worker PWA)
# ------------------------------------------------------------------------------
# Générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@kene.app"

# ------------------------------------------------------------------------------
# 7. DIAGNOSTIC IA CUTANÉ (VLM Multimodal & Recommandations)
# ------------------------------------------------------------------------------
# Clé Google Gemini API pour l'analyse dermatologique sur peaux mélanodermes (IV-VI)
# Obtenir sur : https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Optionnel : ZAI Web Dev SDK (modèle alternatif glm-4.6v)
ZAI_API_KEY=""
