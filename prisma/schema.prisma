// Kènè — Schéma Prisma multi-tenant (SQLite)
// Les types enum sont simulés via String + validation Zod côté API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Globales ───────────────────────────

model Country {
  id        String  @id @default(cuid())
  code      String  @unique // "CI" | "SN"
  name      String
  currency  String  @default("XOF")
  tvaRate   Float   @default(18.0)
  phoneCode String // "+225"
}

model MomoOperator {
  id      String @id @default(cuid())
  code    String @unique // wave | orange | mtn
  name    String
  color   String
  ussd    String
  active  Boolean @default(true)
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String
  role         String   @default("client") // client | pro | admin
  email        String?
  city         String?
  skinType     String? // grasse | seche | mixte | normale
  fitzpatrick  String? // III | IV | V | VI
  allergies    String? // texte libre
  goals        String? // JSON [{id,label}]
  consentHealth Boolean @default(false)
  consentTs    DateTime?
  referralCode String?
  referredBy   String?
  // t. 120 — photo de profil cliente (data URL JPEG redimensionnée côté
  // client, servie par /api/media/user/:id, jamais dans les payloads JSON)
  avatarData   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  diagnoses    Diagnosis[]
  orders       Order[]
  reviews      Review[]
  notifications Notification[]
  consents     Consent[]
  appointments Appointment[] @relation("UserAppointments")
  wallet       Wallet?
  couponRedemptions CouponRedemption[]
  subscriptions Subscription[] // abonnements Kènè+ / Pro (t. 71-c)
  passport     SkinPassport? // Passeport de Peau partageable (t. 82)
}

// ─────────────────────────── Tenants (entreprises) ───────────────────────────

model Tenant {
  id             String   @id @default(cuid())
  name           String
  type           String   @default("institut") // institut | spa | dermo_conseil
  country        String // CI | SN
  city           String
  address        String?
  phone          String
  ownerName      String
  ownerPhone     String
  plan           String   @default("trial") // trial | pro | business
  commissionRate Float    @default(0)
  rating         Float    @default(4.7)
  reviewCount    Int      @default(0)
  description    String?
  // t. 120 — photo de vitrine de l'institut (data URL, servie par
  // /api/media/tenant/:id) — remplace le visuel calculé du nom si posée
  photoData      String?
  openingHour    Int      @default(9)
  closingHour    Int      @default(19)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  resources      Resource[]
  services       Service[]
  clients        ClientProfile[]
  appointments   Appointment[]
  sales          Sale[]
  products       Product[]
  movements      InventoryMovement[]
  employees      Employee[]
  payPeriods     PayPeriod[]
  accounts       ChartAccount[]
  journals       JournalEntry[]
  coupons        Coupon[]
  reviews        Review[]
  notifications  Notification[]
  followUpMarks  FollowUpMark[]
  proDiagnoses   ProDiagnosis[]
  leaves        LeaveRequest[]
}

// ─────────────────────────── Relances « Le Fil du Retour » ───────────────────────────

model FollowUpMark {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dedupKey  String   // "diag:<id>" | "appt:<id>" | "sale:<id>" | "client:<id>"
  status    String   @default("done") // done | dismissed
  via       String?  // whatsapp | call | visit | sms
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dedupKey])
}

model Resource {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  role      String  @default("estheticienne") // estheticienne | dermo_conseillere | caissiere
  color     String  @default("#C8951E")
  active    Boolean @default(true)

  appointments Appointment[]
}

model Service {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  category      String  @default("soin") // soin | gommage | massage | diagnostic | consultation
  durationMin   Int     @default(60)
  price         Int
  commissionPct Float   @default(10)
  description   String?
  botanicals    String? // "Karité, Baobab"
  // t. 120 — visuel du soin (data URL, servie par /api/media/service/:id)
  photoData     String?
  active        Boolean @default(true)

  appointments Appointment[]
  saleItems    SaleItem[]
}

// ─────────────────────────── CRM ───────────────────────────

model ClientProfile {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?   // lien vers User si cliente Kènè
  name        String
  phone       String
  email       String?
  skinType    String?
  fitzpatrick String?
  notes       String?
  visitsCount Int       @default(0)
  totalSpent  Int       @default(0)
  lastVisit   DateTime?
  rfmSegment  String    @default("Nouveau") // Champions | Fidèles | Potentiels | À risque | Perdus | Nouveaux
  createdAt   DateTime  @default(now())

  appointments Appointment[]
  sales        Sale[]
  proDiagnoses ProDiagnosis[]
}

// ─────────────────────────── Diagnostic en institut (questionnaire ± photo) ───────────────────────────

model ProDiagnosis {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientProfileId  String
  clientProfile    ClientProfile @relation(fields: [clientProfileId], references: [id])
  userId           String?      // si la cliente est aussi sur l'app Kènè (notification envoyée)
  zone             String       // visage | dos | cuir_chevelu | mains | barbe | naevi
  practitioner     String?      // praticienne qui a réalisé le diagnostic
  questionnaireJson String      // réponses brutes { questionId: value | value[] }
  photoData        String?      // data URL (optionnelle — photo prise en cabine)
  resultJson       String       // résultat complet (questionnaire ± VLM fusionnés)
  scoreGlobal      Int          @default(0)
  vlmUsed          Boolean      @default(false) // photo analysée par le VLM
  photoUsed        Boolean      @default(false) // photo jointe
  // Consentements recueillis en cabine AVANT le diagnostic (t. 119) — la
  // cliente signe aussi la fiche papier ; ici la trace numérique horodatée.
  consentPhoto     Boolean      @default(false) // prise & conservation de photos par l'institut
  consentData      Boolean      @default(false) // conservation des données de peau par l'institut
  consentTs        DateTime?    // horodatage du consentement
  createdAt        DateTime     @default(now())
}

// ─────────────────────────── RDV ───────────────────────────

model Appointment {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientProfileId String?
  clientProfile  ClientProfile? @relation(fields: [clientProfileId], references: [id])
  userId         String?
  user           User?   @relation("UserAppointments", fields: [userId], references: [id])
  clientName     String
  clientPhone    String
  resourceId     String
  resource       Resource @relation(fields: [resourceId], references: [id])
  serviceId      String
  service        Service @relation(fields: [serviceId], references: [id])
  startAt        DateTime
  durationMin    Int     @default(60)
  status         String  @default("confirmed") // pending | confirmed | completed | cancelled | no_show
  price          Int     @default(0)
  depositAmount  Int     @default(0) // acompte payé via MoMo
  paymentId      String?
  notes          String?
  createdAt      DateTime @default(now())

  review Review?

  @@index([tenantId, startAt]) // agenda : RDV d'un institut par plage de dates
}

// ─────────────────────────── Diagnostic IA ───────────────────────────

model Diagnosis {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone         String // visage | dos | cuir_chevelu | mains | barbe | naevi
  imageData    String   // base64 (redimensionné côté client)
  resultJson   String   // résultat complet VLM
  scoreGlobal  Int      @default(0)
  status       String   @default("pending") // pending | done | error
  vlmUsed      Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt]) // historique diagnostic par cliente
}

// ─────────────────────────── Boutique / Produits / Stock ───────────────────────────

model Product {
  id          String  @id @default(cuid())
  tenantId    String? // null = boutique Kènè (marketplace light)
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  brandLine   String  @default("Kènè Botaniques")
  category    String  @default("soin") // serum | creme | huile | gommage | masque | savon
  description String
  botanicals  String // "Moringa, Karité"
  price       Int
  compareAt   Int?
  stock       Int     @default(50)
  stockAlert  Int     @default(8)
  image       String  // /products/xxx.webp (visuel studio par défaut)
  // t. 120 — photo RÉELLE du produit prise par l'institut (data URL, servie
  // par /api/media/product/:id) — prime sur `image` quand elle existe
  photoData   String?
  rating      Float   @default(4.8)
  reviewCount Int     @default(0)
  active      Boolean @default(true)

  movements InventoryMovement[]
  saleItems SaleItem[]
  orderItems OrderItem[]
}

model Sale {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientProfileId String?
  clientProfile  ClientProfile? @relation(fields: [clientProfileId], references: [id])
  items          SaleItem[]
  subtotal       Int
  discount       Int      @default(0)
  total          Int
  tvaAmount      Int      @default(0) // TVA incluse (18%)
  paymentMethod  String   // wave | orange | cash | card
  paymentRef     String?
  cashierName    String   @default("Caisse 1")
  status         String   @default("completed") // pending | completed | refunded
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt]) // KPIs ventes + compta par période
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kind      String  // service | product
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  label     String
  qty       Int     @default(1)
  unitPrice Int
  total     Int
}

model InventoryMovement {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String // in | out | adjust | loss
  qty       Int
  reason    String
  createdAt DateTime @default(now())
}

// ─────────────────────────── Wallet & Paiements ───────────────────────────

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Int      @default(0)
  cashbackRate Float    @default(0.05)
  referralCode String   @unique
  createdAt    DateTime @default(now())

  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      String // credit | debit
  amount    Int
  reason    String // cashback | referral | topup | payment | refund
  refId     String?
  createdAt DateTime @default(now())

  @@index([walletId, createdAt]) // relevé wallet par cliente (dédup parrainage)
}

model Payment {
  id          String    @id @default(cuid())
  userId      String?
  purpose     String // shop_order | appointment_deposit | wallet_topup | pos_sale
  method      String // wave | orange | cash | card | wallet
  amount      Int
  status      String    @default("pending") // pending | success | failed
  ref         String    @unique
  metaJson    String?   // contexte (orderId, appointmentId…)
  confirmTokenHash String? // sha256 du code de confirmation (t. 63-c) — null = paiement sans code (wallet/POS)
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  order Order?
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  subtotal  Int
  discount  Int      @default(0) // remise coupon appliquée (0 = aucune)
  couponCode String? // code du coupon appliqué (traçabilité)
  cashback  Int      @default(0)
  total     Int
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])
  status    String   @default("pending") // pending | paid | delivered | cancelled
  createdAt DateTime @default(now())

  @@index([userId, createdAt]) // « Mes commandes » par cliente
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  label     String
  qty       Int     @default(1)
  unitPrice Int
  total     Int
}

// ───────────────────── Coupons boutique (Sprint 6) ─────────────────────

model Coupon {
  id          String             @id @default(cuid())
  tenantId    String? // null = coupon maison Kènè (diffusable par l'admin)
  tenant      Tenant?            @relation(fields: [tenantId], references: [id])
  code        String             @unique // PROMO-XXXX, stocké uppercase
  label       String? // description visible cliente (« Fête des mères » )
  kind        String             // percent | fixed
  value       Int                // percent : 5..90 (%) · fixed : 500..500000 (FCFA)
  minOrder    Int                @default(0) // panier minimum pour appliquer
  maxUses     Int                @default(0) // 0 = illimité
  usedCount   Int                @default(0)
  startsAt    DateTime           @default(now())
  expiresAt   DateTime?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String? // commande boutique concernée
  discount  Int      // remise réellement appliquée (FCFA)
  createdAt DateTime @default(now())

  @@unique([couponId, userId]) // UNE seule utilisation par cliente et par coupon
}

model Review {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId String?  @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())
}

model Notification {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  channel      String // sms | whatsapp | email
  toPhone      String
  message      String
  status       String    @default("sent") // sent | scheduled
  scheduledAt  DateTime? // déclenchement prévu (status scheduled) — null = immédiat
  metaJson     String?   // contexte {diagId} | {apptId} | {dedupKey} — annulation intelligente
  readAt       DateTime? // lecture cliente (status sent) — null = non lue
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt]) // badge non-lues + fil client
}

// ─────────────────────────── Abonnements (t. 71-c) ───────────────────────────
// Monétisation Kènè : cliente « Kènè+ » (2 500 F/mois) et pro « Essentiel » /
// « Complexe » (15 000 / 45 000 F/mois). source = "momo_sim" : paiement
// SIMULÉ mobile money (POC — aucun argent réel, mention affichée partout).
model Subscription {
  id        String   @id @default(cuid())
  userId    String
  plan      String   // "kene_plus" | "pro_essentiel" | "pro_complexe"
  status    String   @default("active") // active | cancelled | expired
  priceFcfa Int
  source    String   @default("momo_sim") // paiement simulé POC
  startedAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, status]) // plan actif + quota diagnostics par cliente
}

// ─────────────────────────── Passeport de Peau (t. 82) ───────────────────────────
// QR partageable vers les instituts partenaires : un jeton stable par
// cliente, lisible SANS compte (vue publique /?passport=<token>). Pas de
// photo — profil peau uniquement (phototype, type, allergies, objectifs,
// dernier score, fils d'or). rotatable : régénérer le jeton révoque l'ancien.
model SkinPassport {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
  rotatedAt DateTime?
}

// ─────────────────────────── Web Push VAPID (t. 60-e) ───────────────────────────
// Abonnements navigateur (Push API) — rappels reçus MÊME application fermée.
// endpoint = URL du push service du navigateur (unique par abonnement).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ─────────────────────────── Paie (Sprint 4) ───────────────────────────

model Employee {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  role         String // estheticienne | dermo_conseillere | caissiere | manager
  // t. 96 — compte APP de l'employée : User (rôle « pro ») lié par userId.
  // La fondatrice crée le compte à l'embauche (numéro de l'employée) ;
  // l'employée se connecte par OTP et entre dans l'espace Pro de SON
  // institut avec les sections de son poste (resolveTenant + ProApp).
  userId       String?
  contractType String   @default("CDI") // CDI | CDD | Stage
  country      String // CI | SN
  baseSalary   Int // mensuel brut de base XOF
  transport    Int      @default(0)
  housing      Int      @default(0)
  cadres       Boolean  @default(false) // IPRES cadres (SN)
  hireDate     DateTime @default(now())
  cnpsNumber   String?
  bankAccount  String?
  active       Boolean  @default(true)
  endDate      DateTime? // sortie (null = en poste)

  attendance  Attendance[]
  leaves      LeaveRequest[]
  payslips    Payslip[]
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  checkIn    String?  // "08:32"
  checkOut   String?
  hours      Float    @default(8)
  status     String   @default("present") // present | absent | leave | late
}

model LeaveRequest {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime
  type       String    @default("conge") // conge | maladie | maternite
  days       Int // jours ouverts (dimanche exclu), calculés à la saisie
  status     String    @default("pending") // pending | approved | rejected
  reason     String?   // motif saisi à la demande
  note       String?   // décision (motif de refus p. ex.)
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, startDate])
}

model PayPeriod {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period    String // "2025-06"
  country   String
  status    String   @default("validated") // open | validated
  totalsJson String? // totaux agrégés
  createdAt DateTime @default(now())

  payslips Payslip[]
}

model Payslip {
  id            String   @id @default(cuid())
  payPeriodId   String
  payPeriod     PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary    Int
  hoursWorked   Float    @default(173.33)
  grossSalary   Int
  cnpsEmployee  Int      @default(0)
  cnpsEmployer  Int      @default(0)
  incomeTax     Int      @default(0) // IGR (CI) ou IR (SN)
  cn            Int      @default(0) // Contribution Nationale CI
  netSalary     Int
  detailsJson   String   // détail complet lignes
  createdAt     DateTime @default(now())
}

// ─────────────────────────── Compta SYSCOHADA ───────────────────────────

model ChartAccount {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code     String // "701000"
  classe   Int // 1..9
  label    String
  type     String // actif | passif | charge | produit
  system   Boolean @default(true) // compte du plan SYSCOHADA pré-chargé

  entries JournalLine[]
}

model JournalEntry {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalCode String  @default("CA") // VE (ventes) | BQ (banque) | CA (caisse) | PA (paie) | OD
  date       DateTime
  reference  String
  description String
  sourceType String? // sale | payroll | manual
  sourceId   String?
  lines      JournalLine[]
  createdAt  DateTime @default(now())
}

model JournalLine {
  id        String       @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   ChartAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  debit     Int          @default(0)
  credit    Int          @default(0)
  label     String?
}

// ─────────────────────────── Sécurité / Conformité ───────────────────────────

model Consent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // health_data | photo_storage | marketing | whatsapp | share_scans
  // Pour type = share_scans: institut concerné par le partage des self-scans
  // (null pour les consentements globaux du compte).
  tenantId  String?
  granted   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, type, tenantId])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  userId      String?
  action      String
  entity      String
  entityId    String?
  detailsJson String?
  createdAt   DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone]) // vérification OTP par téléphone
}

// ─────────────────────────── Sécurité — journal d'audit (t. 86-d) ───────────────────────────
// Journal léger des événements sensibles (OTP, connexions, paiements, accès
// console…). `phone` est TOUJOURS stocké MASQUÉ (ex. « +225 07•••••04 ») —
// jamais de numéro complet ; `detail` reste court (≤ 180 chars), sans secret.
// Prune paresseux côté serveur : > 90 jours d'ancienneté = supprimé.
model SecurityEvent {
  id      String   @id @default(cuid())
  ts      DateTime @default(now())
  kind    String   // otp_request | login_success | login_failed | login_locked | logout | pro_register | payment_confirm | admin_access | push_subscribe | upload_reject
  phone   String?  // MASQUÉ avant stockage (ex. +225 07•••••04) — JAMAIS de numéro complet
  userId  String?
  ip      String?
  detail  String?  // court, sans secret

  @@index([ts]) // visionneuse admin : les 80 plus récents, ts desc
}

// ─────────────────────────── Cercle Kènè (t. 83-b) ───────────────────────────
// Le cercle des témoignages : les voix de celles qui tissent avant. Contenu
// public de démonstration (POC) — prénom + initiale, jamais de nom complet,
// aucune donnée personnelle réelle, aucune relation : la carte est servie
// telle quelle par GET /api/testimonials (seed paresseux au premier appel).

model Testimonial {
  id        String   @id @default(cuid())
  author    String // « Aminata K. » — prénom + initiale, jamais le nom complet
  city      String // « Cocody », « Yamoussoukro »…
  zone      String? // zone concernée (visage, dos, cuir chevelu…)
  text      String // 140-260 caractères, vécu concret
  months    Int // durée du parcours en mois (« 4 mois avec Kènè »)
  rating    Int // 4 ou 5
  threads   Int? // fils d'or de l'utilisatrice si connue
  featured  Boolean  @default(true)
  createdAt DateTime @default(now())
}
