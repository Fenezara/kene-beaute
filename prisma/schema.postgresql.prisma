  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ SÃ©curitÃ© â€” journal d'audit (t. 86-d) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Journal lÃ©ger des Ã©vÃ©nements sensibles (OTP, connexions, paiements, accÃ¨s
// consoleâ€¦). `phone` est TOUJOURS stockÃ© MASQUÃ‰ (ex. Â« +225 07â€¢â€¢â€¢â€¢â€¢04 Â») â€”
// jamais de numÃ©ro complet ; `detail` reste court (â‰¤ 180 chars), sans secret.
// Prune paresseux cÃ´tÃ© serveur : > 90 jours d'anciennetÃ© = supprimÃ©.
model SecurityEvent {
  id      String   @id @default(cuid())
  ts      DateTime @default(now())
  kind    String   // otp_request | login_success | login_failed | login_locked | logout | pro_register | payment_confirm | admin_access | push_subscribe | upload_reject
  phone   String?  // MASQUÃ‰ avant stockage (ex. +225 07â€¢â€¢â€¢â€¢â€¢04) â€” JAMAIS de numÃ©ro complet
  userId  String?
  ip      String?
  detail  String?  // court, sans secret

  @@index([ts]) // visionneuse admin : les 80 plus rÃ©cents, ts desc
}

